# Zoho OAuth (self-client / refresh-token credentials — see zia-agent.env for the reference values)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Optional overrides — defaults match the deployed Senior Projects Manager agent
# ZOHO_TOKEN_URL=https://accounts.zoho.com/oauth/v2/token
# ZIA_AGENT_BASE_URL=https://ziaagents.zoho.com/ziaagents/api/v1/agents
# ZIA_AGENT_ORG_ID=933376281

# Zia conversation session. LEAVE UNSET in normal operation: the gateway then
# generates a fresh numeric session id per call, so independent requests don't
# replay one another's history into the model context. Set this only to pin
# every call in the deployment to one long-lived conversation. Zia requires a
# numeric value — letters are rejected with HTTP 400 INVALID_SESSION_ID.
# ZIA_AGENT_SESSION_ID=10000

# Agent registry (src/agents.ts) overrides
# ZIA_SENIOR_PROJECTS_MANAGER_AGENT_ID=20971000000021961
# ZIA_DEFAULT_AGENT=senior-projects-manager

# Shared secret clients must send as "Authorization: Bearer <value>" to POST /mcp.
# Required when NODE_ENV=production.
MCP_SERVER_API_KEY=

# Streamable HTTP host-header validation (see README) — leave unset for the
# permissive default (no restriction, just a startup warning).
# MCP_HTTP_HOST=0.0.0.0
# MCP_ALLOWED_HOSTS=your-deployment-host.example.com

# HTTP port (defaults to 3000; most PaaS providers inject this automatically)
PORT=3000

# "http" (default, for remote/cloud deployment) or "stdio" (for local MCP clients)
TRANSPORT=http
