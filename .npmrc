# Render (and any host that sets NODE_ENV=production) makes `npm install` omit
# devDependencies. This build needs them: typescript compiles src/ to dist/, and
# @types/node + @types/express supply the ambient types for process, Buffer,
# console, URLSearchParams and the express request/response signatures.
# `include` beats `omit` in npm regardless of ordering or NODE_ENV.
include=dev
